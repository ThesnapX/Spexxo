# frontend/.env.example
#
# Copy to .env and fill in real values.
# Anything prefixed with VITE_ is bundled into the client — NEVER put
# secrets here.

# ─────────────────────────────────────────────
# API
# ─────────────────────────────────────────────
# Backend API root, including /api
VITE_API_URL=http://localhost:5000/api

# ─────────────────────────────────────────────
# Canonical site URL
# ─────────────────────────────────────────────
# Used for canonical tags, Open Graph, structured data, sitemap.
# Set this to your production domain before going live on a custom domain.
VITE_SITE_URL=https://spexxo.vercel.app

# ─────────────────────────────────────────────
# Razorpay (public key only)
# ─────────────────────────────────────────────
# Public, safe to expose. Secret lives on the backend.
VITE_RAZORPAY_KEY_ID=

# ─────────────────────────────────────────────
# Meta Pixel (public ID only)
# ─────────────────────────────────────────────
# Public, safe to expose. Access token is CAPI-only and lives on backend.
VITE_META_PIXEL_ID=1753741932563893

# ─────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────
# Explicit public site URL for sharing links (falls back to VITE_SITE_URL)
# VITE_FRONTEND_URL=https://spexxo.vercel.app